// prelude-imports-only: ordinary imports before the pipeline block are
// reported at info level (PB-GROOVY-IMPORT) and do not block migration:
// imports bring symbols into the Groovy runtime but are not executable
// pipeline behavior. References to imported symbols inside steps are still
// reported separately.
import hudson.model.Result
import hudson.model.Run
import jenkins.model.CauseOfInterruption.UserInterruption

pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                sh 'make build'
            }
        }
        stage('Test') {
            steps {
                sh 'make test'
            }
        }
    }
}
